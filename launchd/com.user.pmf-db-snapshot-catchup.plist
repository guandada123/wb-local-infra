<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.user.pmf-db-snapshot-catchup</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/guan/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>HOME</key>
		<string>/Users/guan</string>
	</dict>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/guan/.local/bin/pmf-db-snapshot-catchup.py</string>
	</array>
	<!-- 03:00 原任务保持不变；本任务每小时检查，睡眠错过后由唤醒时的间隔触发补跑 -->
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/guan/.local/log/pmf-db-snapshot-catchup.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/guan/.local/log/pmf-db-snapshot-catchup.err</string>
</dict>
</plist>
