<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.colima-shutdown-guard</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/guan/.colima/colima-shutdown-guard.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>AlwaysSIGTERMOnShutdown</key>
    <true/>
    <key>ExitTimeOut</key>
    <integer>90</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>COLIMA</key>
        <string>/opt/homebrew/bin/colima</string>
        <key>HA_PIDFILE</key>
        <string>/Users/guan/.colima/_lima/colima/ha.pid</string>
        <key>LOG</key>
        <string>/Users/guan/.colima/shutdown-guard.log</string>
    </dict>
</dict>
</plist>
