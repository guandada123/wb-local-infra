#!/usr/bin/env bash
# infra-sync-check：每日校验中台基础设施的五类漂移
#   ① 脚本：仓内 bin/ ↔ 已部署 ~/.local/bin 逐字节一致（tests/test_deploy_sync.py）
#   ② plist：live → 仓内 launchd/ 快照是否过期（DR 基线不过期才可恢复）
#   ③ 归档索引：_archive 变动后 INDEX.md 是否过期
#   ④ cwd 锚点：自动化工作目录是否还在（删了会让自动化失联）
#   ⑤ 马厩归档总册：台账/档案/归档区变了而总册没重跑（云端那份即过期）
# 全绿 → 静默（只写日志）；有漂移 → push_card 推飞书（一张卡，按类分节）。
#
# 🔴 FAIL-SAFE 铁律（2026-11-20 审计 P0-1 修复）：
#   「检查没发现问题」与「检查本身没跑成」必须区分。判定只看 **rc**，不看输出文本是否为空。
#   历史 bug：终判用 `[ -z "$reason" ] && [ stale -eq 0 ]`——unittest 崩溃 / active.txt 丢失时
#   两处都"空"，于是报 OK（exit 0）。删掉 tests/ 目录都能拿到 OK，比没闸门更危险。
#
# 注意：wb-local-infra 在 ZHITAI 外置卷 —— 后台任务读写必须用授权 python（TCC），
# 故本脚本固定用 ~/.workbuddy/binaries 的 python，且由它派生子进程。
set -uo pipefail

# launchd 空环境下 HOME 可能未设置（实测：set -u 直接死于 "HOME: unbound variable"，
# 于是每日检查从未真正执行、也不报错）。这里先兜底取 passwd 里的家目录。
if [ -z "${HOME:-}" ]; then
  HOME="$(cd ~ 2>/dev/null && pwd)" || HOME="$(eval echo "~$(id -un)")"
  export HOME
fi

# push_card → lark-cli → node：launchd 的默认 PATH 里没有 node（实测报
# "exec: node: not found"），卡片静默发不出去。node 只有版本目录、没有稳定入口，
# 这里每次运行动态解析（抗升级），并补上 PATH。
_NODE_BIN="$(ls -d "$HOME"/.workbuddy/binaries/node/versions/*/bin 2>/dev/null | head -1)"
export PATH="$HOME/.local/bin:${_NODE_BIN:+$_NODE_BIN:}/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

PY="$HOME/.workbuddy/binaries/python/envs/default/bin/python"
REPO="${REPO_OVERRIDE:-$HOME/WorkBuddy/wb-local-infra}"
LOG="${LOG_OVERRIDE:-$HOME/.agent-autoloop/logs/infra-sync-check.log}"
AGENTS="${AGENTS:-$HOME/Library/LaunchAgents}"   # 测试可覆盖，避免动真实 LaunchAgents
mkdir -p "$(dirname "$LOG")"
log() { printf '[%s] %s\n' "$(date '+%F %T')" "$*" >> "$LOG"; }

if [ ! -d "$REPO" ]; then
  # 仓不存在也是"检查没跑成"，不能静默当没事
  log "ERROR: 仓不存在 $REPO —— 本次未做任何校验"
  echo "ERROR: 仓不存在 $REPO"
  exit 1
fi

# ---------- ① 脚本漂移（判据=rc） ----------
script_issue=""
out="$(cd "$REPO" && "$PY" -m unittest discover -s tests 2>&1)"; rc=$?
if [ "$rc" -ne 0 ]; then
  printf '%s\n' "$out" | tail -20 >> "$LOG"
  reason="$(printf '%s\n' "$out" | grep -E 'live 已漂移|未部署到' | head -2)"
  script_issue="${reason:-unittest 失败 rc=${rc}（非断言失败，详见日志 ${LOG}）}"
  log "DRIFT(script): unittest rc=$rc"
fi

# ---------- ② plist 快照过期（判据=rc + 可解析） ----------
plist_issue=""
snap_out="$(AGENTS="$AGENTS" "$REPO/install.sh" --snapshot-plists 2>&1)"; snap_rc=$?
plist_stale=""
if [ "$snap_rc" -ne 0 ]; then
  plist_issue="快照检查自身失败(rc=$snap_rc)：$(printf '%s\n' "$snap_out" | tail -2)"
  log "ERROR(plist): 检查失败 rc=$snap_rc"
else
  plist_stale="$(printf '%s\n' "$snap_out" | grep -oE '刷新=[0-9]+' | head -1 | cut -d= -f2)"
  if [ -z "$plist_stale" ]; then
    # rc=0 但输出无法解析 = 契约被改，同样不能当"没问题"
    plist_issue="快照检查输出无法解析（install.sh 契约变更？）：$(printf '%s\n' "$snap_out" | tail -2)"
    log "ERROR(plist): 输出不可解析"
  elif [ "$plist_stale" -gt 0 ]; then
    plist_issue="快照过期 ${plist_stale} 个"
    log "STALE(plist): ${plist_stale} 个"
  fi
fi
# ---------- ③ 归档索引是否过期（_archive 变动后 INDEX.md 会过期） ----------
idx_issue=""
IDX_SCRIPT="$REPO/bin/archive-index.py"
if [ -f "$IDX_SCRIPT" ]; then
  idx_out="$("$PY" "$IDX_SCRIPT" --check --dir "${ARCHIVE_DIR:-$HOME/WorkBuddy/_archive}" 2>&1)"; idx_rc=$?
  case "$idx_rc" in
    0) : ;;
    1) idx_issue="与 _archive 不一致（跑 archive-index.py 重建）"
       log "STALE(index): $(printf '%s\n' "$idx_out" | tail -1)" ;;
    2) log "INFO(index): 索引不存在或不适用，跳过" ;;
    *) idx_issue="索引检查失败(rc=$idx_rc)：$(printf '%s\n' "$idx_out" | tail -2)"
       log "ERROR(index): 检查失败 rc=$idx_rc" ;;
  esac
fi

# ---------- ⑤ 马厩归档总册是否过期（T-045：日常降级为日志，连续 N 天才推卡） ----------
# 2026-11-28：总册不是「每天都需要刷新」的对象，每日必推卡 = 每日必忽略（告警疲劳）；
# 但它也不是无害信息（DR/交接要靠它）。故分档：
#   · 日常过期  → 只写日志，不推卡
#   · 连续 ≥ MAJIU_ESCALATE_DAYS 天过期 → 推一张卡，且**只推一次**（按「本轮过期起始日」去重）
#   · 恢复正常  → 清状态文件，下次重新计数
# 状态文件记三件：first_stale（本轮连续过期起始日）、pushed_for（已为该起始日推过卡的标记）。
MAJIU_ESCALATE_DAYS=7
# 状态文件：默认落在 ~/.local/state。加 MAJIU_STATE_OVERRIDE 是为了**测试隔离** ——
# 2026-11-28 实测：`tests/test_deploy_sync.py` 会以各种 DRY_RUN 组合调用本脚本，
# 若它们共用真实状态文件，就会把本机「连续过期计数」搅乱（生产状态被测试改写）。
# 这是「隔离」位，不是「改判据」位：它只换文件位置，不换任何阈值/分支语义。
# 阈值 MAJIU_ESCALATE_DAYS 保持硬编码 —— 那才是真正的判据，不该被环境改。
MAJIU_STATE="${MAJIU_STATE_OVERRIDE:-$HOME/.local/state/majiu-stale.json}"

majiu_streak_days() {
  # 输出本轮已连续过期多少天。**文件不存在 = 0**（初见，还没记过），存在才按起始日算。
  # 初版文件不存在也返回 1，把「刚记下」当成「已连续 1 天」，语义偏了一天。
  [ -f "$MAJIU_STATE" ] || { echo 0; return; }
  "$PY" - "$MAJIU_STATE" <<'PYEOF' 2>/dev/null || echo 0
import json, sys, datetime
try:
    d = json.load(open(sys.argv[1]))
    first = datetime.date.fromisoformat(d["first_stale"])
    print((datetime.date.today() - first).days + 1)
except Exception:
    print(0)
PYEOF
}

majiu_note_stale() {
  # 记一笔「今天仍过期」。**起始日只在文件不存在时写一次，之后绝不覆盖**
  # ——初版无条件 setdefault 后紧跟回写，第二次跑就重新算起，连续天数永远回到 1（实测 3/4 卡在这）。
  [ -f "$MAJIU_STATE" ] && return 0
  "$PY" - "$MAJIU_STATE" <<'PYEOF' 2>/dev/null || true
import json, sys, datetime, pathlib
p = pathlib.Path(sys.argv[1])
today = datetime.date.today().isoformat()
p.parent.mkdir(parents=True, exist_ok=True)
p.write_text(json.dumps({"first_stale": today, "last_seen": today}, ensure_ascii=False))
PYEOF
}

majiu_mark_pushed() {
  "$PY" - "$MAJIU_STATE" <<'PYEOF' 2>/dev/null || true
import json, sys, pathlib
p = pathlib.Path(sys.argv[1])
try:
    d = json.loads(p.read_text())
except Exception:
    d = {}
d["pushed_for"] = d.get("first_stale")
p.write_text(json.dumps(d, ensure_ascii=False))
PYEOF
}

majiu_already_pushed() {
  # 本轮起始日是否已推过卡（幂等：同一轮只推一次）
  "$PY" - "$MAJIU_STATE" <<'PYEOF' 2>/dev/null || echo 0
import json, sys, pathlib
try:
    d = json.loads(pathlib.Path(sys.argv[1]).read_text())
    print(1 if d.get("pushed_for") and d["pushed_for"] == d.get("first_stale") else 0)
except Exception:
    print(0)
PYEOF
}

majiu_clear_state() {
  rm -f "$MAJIU_STATE" 2>/dev/null || true
}

# ---------- ⑤ 马厩归档总册是否过期（台账/档案/归档区变了而总册没重跑） ----------
majiu_issue=""
MAJIU_SCRIPT="$REPO/bin/majiu-archive-index.py"
MAJIU_FILE="${MAJIU_FILE:-${MAJIU_HOME:-$HOME/WorkBuddy}/马厩归档总册.md}"
if [ -f "$MAJIU_SCRIPT" ]; then
  # 总册自己声明生成模式（本机 / 资料库实读），--check 按该模式重建再比对
  mj_args=(--check "$MAJIU_FILE")
  [ -n "${MAJIU_HOME:-}" ] && mj_args+=(--workbuddy-home "$MAJIU_HOME")
  mj_out="$("$PY" "$MAJIU_SCRIPT" "${mj_args[@]}" 2>&1)"; mj_rc=$?
  case "$mj_rc" in
    0) majiu_clear_state ;;
    1) # 2026-11-28（T-045）分档：**先算 streak 再决定是否记起始日**。
       # 初版先 note_stale 再算，note_stale 会把「今天」写成起始日，导致同一次调用里
       # 永远算出 streak=1，看起来对；但第二次跑时起始日已固定、无法再靠「先写后算」。
       # 正确语义：用**既有**状态算连续天数；初次（0）当天不算升级，只记起始日。
       streak="$(majiu_streak_days)"
       [ "$streak" -eq 0 ] && { majiu_note_stale; streak=1; }
       if [ "$streak" -ge "$MAJIU_ESCALATE_DAYS" ]; then
         if [ "$(majiu_already_pushed)" = "1" ]; then
           log "STALE(majiu): 连续 ${streak} 天过期，本轮已推过卡（去重），今日不再推"
         else
           majiu_issue="总册已过期 **连续 ${streak} 天**（阈值 ${MAJIU_ESCALATE_DAYS} 天）：$(printf '%s\n' "$mj_out" | tail -1)"
           log "STALE(majiu): 连续 ${streak} 天，升级为卡片"
         fi
       else
         log "STALE(majiu): 连续 ${streak} 天过期（< ${MAJIU_ESCALATE_DAYS} 天阈值，仅日志不推卡）"
       fi ;;
    2) majiu_issue="总册不存在：$MAJIU_FILE"
       log "MISSING(majiu): $MAJIU_FILE" ;;
    3) # 读不到云端清单 = 比对没做成，不能当过期，更不能当 OK
       majiu_issue="总册检查未能完成（资料库未实读）：$(printf '%s\n' "$mj_out" | tail -1)"
       log "ERROR(majiu): 无法比对（资料库不可达）" ;;
    *) majiu_issue="总册检查失败(rc=$mj_rc)：$(printf '%s\n' "$mj_out" | tail -2)"
       log "ERROR(majiu): 检查失败 rc=$mj_rc" ;;
  esac
fi

# 清单未登记（live 有但 active.txt 无）：只记日志，不推卡（新 job 属正常演进）
unlisted="$(printf '%s\n' "$snap_out" | grep -cE 'live 有但清单无')"
[ "${unlisted:-0}" -gt 0 ] && log "INFO: 有 ${unlisted} 个 live plist 未登记 active.txt"

# ---------- ④ 自动化 cwd 锚点是否还在（删了会让 12 条自动化失效） ----------
anchor_issue=""
ANCHORS="$REPO/launchd/cwd-anchors.txt"
if [ -f "$ANCHORS" ]; then
  missing_anchors=""
  while IFS= read -r line; do
    case "$line" in \#*|"") continue ;; esac
    apath="$(printf '%s' "$line" | sed 's/[[:space:]]*#.*$//' | tr -d ' ')"
    [ -n "$apath" ] || continue
    [ -d "$apath" ] || missing_anchors="${missing_anchors}${apath} "
  done < "$ANCHORS"
  if [ -n "$missing_anchors" ]; then
    anchor_issue="cwd 锚点缺失（对应自动化会失联）：${missing_anchors}"
    log "MISSING(anchor): ${missing_anchors}"
  fi
fi

# ---------- 汇总（五类都真通过才 OK） ----------
if [ -z "$script_issue" ] && [ -z "$plist_issue" ] && [ -z "$idx_issue" ] && [ -z "$anchor_issue" ] && [ -z "$majiu_issue" ]; then
  n_bin="$("$PY" -c 'import pathlib,sys;print(sum(1 for f in (pathlib.Path(sys.argv[1])/"bin").iterdir() if f.is_file()))' "$REPO" 2>/dev/null || echo "?")"
  ok_line="OK: 五类通过（脚本一致 ${n_bin} 个 / plist 快照 / 归档索引 / cwd 锚点 / 马厩总册）"
  log "$ok_line"
  [ "${DRY_RUN:-0}" = "1" ] && echo "$ok_line"
  exit 0
fi

# DRY_RUN=1：只打印不推送（验证失败路径用，零刷群副作用）
if [ "${DRY_RUN:-0}" = "1" ]; then
  echo "DRY_RUN: 将推送——脚本「${script_issue:-无}」/ plist「${plist_issue:-无}」/ 索引「${idx_issue:-无}」/ 锚点「${anchor_issue:-无}」/ 总册「${majiu_issue:-无}」"
  log "DRY_RUN: 脚本「${script_issue:-无}」/ plist「${plist_issue:-无}」/ 索引「${idx_issue:-无}」/ 锚点「${anchor_issue:-无}」/ 总册「${majiu_issue:-无}」"
  exit 0
fi

args=(--title "🟠 中台基础设施漂移" --level warning)
[ -n "$script_issue" ] && args+=(--section "① 脚本" "${script_issue}
修法：把 live 改动回迁仓内 bin/ 后提交，或 ./install.sh --apply 以仓覆盖")
[ -n "$plist_issue" ] && args+=(--section "② plist 快照" "${plist_issue}
修法：./install.sh --snapshot-plists-apply 刷新（DR 基线）")
[ -n "$anchor_issue" ] && args+=(--section "④ 自动化 cwd 锚点" "${anchor_issue}
修法：从废纸篓恢复该目录，或按 launchd/cwd-anchors.txt 里的说明处理")
[ -n "$idx_issue" ] && args+=(--section "③ 归档索引" "${idx_issue}
修法：python3 ~/WorkBuddy/wb-local-infra/bin/archive-index.py（重建 _archive/INDEX.md）")
[ -n "$majiu_issue" ] && args+=(--section "⑤ 马厩归档总册" "${majiu_issue}
修法：python3 ~/WorkBuddy/wb-local-infra/bin/majiu-archive-index.py --with-library --out ~/WorkBuddy/马厩归档总册.md，然后**把这份覆盖到资料库「马厩归档总册」文档**（本机侧无法自动上传；只重建本机文件，资料库那份仍是旧的）")
"$PY" "$HOME/.local/bin/push_card.py" "${args[@]}" 2>>"$LOG" || log "push_card 失败（见上）"
# T-045 去重：这一轮因「总册连续过期」进卡片时打标记，后续每天不再重复推
[ -n "$majiu_issue" ] && majiu_mark_pushed
exit 0
