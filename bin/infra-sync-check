#!/usr/bin/env bash
# infra-sync-check：每日校验 wb-local-infra 仓内 bin/ 与已部署 ~/.local/bin 逐字节一致。
# 不一致（漂移）→ push_card 推飞书；一致 → 静默（只写日志）。
#
# 为什么需要：tests/test_deploy_sync.py 只在手动跑时生效；漂移是时间维度问题
# （有人手改 live ≠ 仓），必须定时发现。挂 launchd com.user.infra-sync-check。
#
# 注意：wb-local-infra 在 ZHITAI 外置卷 —— 后台任务读写必须用授权 python（TCC），
# 故本脚本固定用 ~/.workbuddy/binaries 的 python，且由它派生 unittest 子进程。
set -uo pipefail

PY="$HOME/.workbuddy/binaries/python/envs/default/bin/python"
REPO="$HOME/WorkBuddy/wb-local-infra"
LOG="$HOME/.agent-autoloop/logs/infra-sync-check.log"
mkdir -p "$(dirname "$LOG")"
log() { printf '[%s] %s\n' "$(date '+%F %T')" "$*" >> "$LOG"; }

if [ ! -d "$REPO" ]; then
  log "SKIP: 仓不存在 $REPO"
  exit 0
fi

out="$(cd "$REPO" && "$PY" -m unittest discover -s tests 2>&1)"
rc=$?
if [ "$rc" -eq 0 ]; then
  n_bin="$("$PY" -c 'import pathlib,sys;print(sum(1 for f in (pathlib.Path(sys.argv[1])/"bin").iterdir() if f.is_file()))' "$REPO" 2>/dev/null || echo "?")"
  log "OK: sync 一致（${n_bin} 个脚本）"
  exit 0
fi

log "DRIFT: unittest rc=$rc"
printf '%s\n' "$out" | tail -20 >> "$LOG"

# 失败详情（取断言消息里的文件清单）
reason="$(printf '%s\n' "$out" | grep -E 'live 已漂移|未部署到' | head -2)"

# DRY_RUN=1：只打印不推送（验证失败路径用，零刷群副作用）
if [ "${DRY_RUN:-0}" = "1" ]; then
  log "DRY_RUN: 将推送「中台脚本同步漂移」—— ${reason:-无详情}"
  exit 0
fi
"$PY" "$HOME/.local/bin/push_card.py" \
  --title "🟠 中台脚本同步漂移" \
  --level warning \
  --section "漂移详情" "${reason:-见日志 $LOG}" \
  --section "修法" "把 live 改动回迁仓内 bin/ 后提交，或 ./install.sh --apply 以仓覆盖" 2>>"$LOG" || log "push_card 失败（见上）"
exit 0
