diff --git a/kernel/decide.ts b/kernel/decide.ts
index e6dfde2..66dab5b 100644
--- a/kernel/decide.ts
+++ b/kernel/decide.ts
@@ -576,6 +576,40 @@ function nextCard(draft: Draft, channel: string) {
   return null;
 }
 
+/**
+ * The vendors' billing peaks (Mon–Fri 09:00–12:00 and 14:00–18:00) cost double; every other hour is half price.
+ * A review is never in a hurry, so one that comes due inside a peak waits for that peak to end — a few minutes
+ * later costs half as much. Weekends are off-peak all day.
+ */
+const PEAK_WINDOWS: ReadonlyArray<readonly [number, number]> = [
+  [9 * 60, 12 * 60],
+  [14 * 60, 18 * 60],
+];
+
+/** How long a review due now should be held back to keep it out of a billing peak; null when it may start now.
+ *
+ * Two known limits, declared rather than silently assumed:
+ *  - the windows are the vendors' own, defined in UTC+8; the timezone comes from the rules, so a rules file
+ *    written for another zone would shift them. Keep rules.timezone at Asia/Shanghai.
+ *  - weekends are handled; Chinese public holidays are not (they are off-peak all day upstream), so a holiday
+ *    daytime review waits until 12:00 for nothing. Harmless, only slower.
+ */
+function peakHold(now: number, timezone: string): number | null {
+  const parts = new Intl.DateTimeFormat("en-US", {
+    timeZone: timezone,
+    weekday: "short",
+    hour: "2-digit",
+    minute: "2-digit",
+    hourCycle: "h23",
+  }).formatToParts(now);
+  const at = (type: string) => parts.find((part) => part.type === type)?.value ?? "";
+  const weekday = at("weekday");
+  if (weekday === "Sat" || weekday === "Sun") return null;
+  const minutes = Number(at("hour")) * 60 + Number(at("minute"));
+  for (const [from, to] of PEAK_WINDOWS) if (minutes >= from && minutes < to) return (to - minutes) * MINUTE;
+  return null;
+}
+
 /** What the clock has brought: schedules come round, reviews come due, and anything gone quiet. */
 function tick(draft: Draft) {
   const { now } = draft;
@@ -609,8 +643,15 @@ function tick(draft: Draft) {
     put(draft, "schedules", rule.name, { next_at: nextAt() });
   }
   const due = rows(draft.view, "timers", { event_id: null }).filter((timer) => Date.parse(timer.at) <= now);
+  const hold = peakHold(now, timezone);
   for (const timer of due.sort((a, b) => a.at.localeCompare(b.at))) {
     const rule = ruleNamed(draft, timer.rule);
+    // A review is not urgent: inside a billing peak it waits for the peak to end instead of paying double.
+    // A timer whose rule is gone sends a notice and costs nothing, so that one is never held back.
+    if (rule && hold !== null) {
+      put(draft, "timers", timer.id, { at: iso(now + hold) });
+      continue;
+    }
     const event = { id: `timer:${timer.id}`, type: "timer.due", subject: timer.lane, hops: timer.hops ?? 0 };
     const eventId = recordEvent(draft, timer.source, event, rule ? [rule.name] : []);
     if (rule) {
