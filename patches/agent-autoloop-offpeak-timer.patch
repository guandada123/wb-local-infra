   it.check();
 });
 
+test("a due check whose rule has gone is told at once, not held back for a peak", () => {
+  const it = hub();
+  it.message();
+  const first = it.claim();
+  it.act("finish", first.run, first.token, {
+    outcome: "done",
+    session: "S",
+    later: [{ key: "复查", at: "2026-11-05T01:30:00Z", about: "规则没了也到期" }],
+  });
+  const without = structuredClone(rules);
+  without.rules = without.rules.filter((rule) => rule.name !== "意见");
+  it.act("rules", without);
+  it.pass(90); // 09:30 in Asia/Shanghai, inside a peak
+  it.act("tick");
+  // Nothing starts (the rule is gone), but the notice is not worth deferring: it costs no tokens.
+  assert.equal(it.claim(), null);
+  assert.equal(it.cards().filter((card: any) => card.kind === "notice").length, 1);
+  it.check();
+});
