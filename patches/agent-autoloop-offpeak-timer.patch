   it.act("tick");
   const due = it.claim();
   assert.equal(due.session, null);
@@ -265,6 +265,61 @@ test("a due check doesn't open a session a round may still be running in, and st
   it.check();
 });
 
+test("a due check that comes due inside a billing peak waits for the peak to end", () => {
+  const it = hub();
+  it.message();
+  const first = it.claim();
+  // 09:30 in Asia/Shanghai: inside a peak, so nothing starts and the check is put off to 12:00.
+  it.act("finish", first.run, first.token, {
+    outcome: "done",
+    session: "S",
+    later: [{ key: "复查", at: "2026-11-05T01:30:00Z", about: "峰值里到期" }],
+  });
+  it.pass(90); // 09:30
+  it.act("tick");
+  assert.equal(it.claim(), null);
+  it.pass(150); // 12:00, the first moment out of the peak
+  it.act("tick");
+  const due = it.claim();
+  assert.equal(due.context.timers[0].about, "峰值里到期");
+  it.check();
+});
+
+test("a due check landing exactly on 09:00 waits, because the peak starts at 09:00", () => {
+  const it = hub();
+  it.message();
+  const first = it.claim();
+  // 09:00 sharp in Asia/Shanghai: the first minute of a peak, so it must wait the whole window.
+  it.act("finish", first.run, first.token, {
+    outcome: "done",
+    session: "S",
+    later: [{ key: "复查", at: "2026-11-05T01:00:00Z", about: "整点到期" }],
+  });
+  it.pass(60); // 09:00
+  it.act("tick");
+  assert.equal(it.claim(), null);
+  it.pass(180); // 12:00
+  it.act("tick");
+  assert.equal(it.claim().context.timers[0].about, "整点到期");
+  it.check();
+});
+
+test("a due check landing exactly on 12:00 does not wait, because the peak ends at 12:00", () => {
+  const it = hub();
+  it.message();
+  const first = it.claim();
+  // 12:00 in Asia/Shanghai is already off-peak: the window is [09:00, 12:00).
+  it.act("finish", first.run, first.token, {
+    outcome: "done",
+    session: "S",
+    later: [{ key: "复查", at: "2026-11-05T04:00:00Z", about: "峰尾到期" }],
+  });
+  it.pass(240); // 12:00
+  it.act("tick");
+  assert.equal(it.claim().context.timers[0].about, "峰尾到期");
+  it.check();
+});
+
 test("without the option, an answer doesn't open a session a round may still be running in either", () => {
   const it = hub();
   const without = structuredClone(rules);
