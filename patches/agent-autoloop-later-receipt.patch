Subject: [PATCH 1/2] =?UTF-8?q?fix(validate):=20later=20=E9=A1=B9=E5=86=99?=
 =?UTF-8?q?=20cancel:false=20=E6=97=B6=E4=B8=8D=E5=86=8D=E6=95=B4=E4=BB=BD?=
 =?UTF-8?q?=E5=9B=9E=E6=89=A7=E8=A2=AB=E6=8B=92?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

validLater 的 else 分支要求 cancel === undefined，于是显式写 "cancel": false
（语义等同"没取消"）会让整份回执判不合规，其中的 later 全部丢失；
而报错文案只提 key/at/about，看不出问题出在 cancel。

实测（2026-11-23 run 252，stdout-1.log）：回执 JSON 合法、1 项、key/at(带时区)/about
(418 字) 全合规，仍被判红，06:30 的复查从未排期。同类卡片 11-19(#34) 已出现一次。

改为 cancel !== true：false 与「不写」等价，true 仍按取消处理。
新增 tests/later-cancel.test.ts 三项断言（false 接受 / true 语义不变 /
缺 at、缺 key、超 10 项仍拒收）。

全量 tests/!(simulation)：797 项 14 失败，A/B 对照证明撤补丁同样 14 失败
（installer/权限/进程组环境类），与本改动无关。
---
 protocol/validate.ts       |  2 +-
 tests/later-cancel.test.ts | 26 ++++++++++++++++++++++++++
 2 files changed, 27 insertions(+), 1 deletion(-)
 create mode 100644 tests/later-cancel.test.ts

diff --git a/protocol/validate.ts b/protocol/validate.ts
index 85859ae..943c6ab 100644
--- a/protocol/validate.ts
+++ b/protocol/validate.ts
@@ -145,7 +145,7 @@ const validLater = (later: Item) =>
   text(later.key, 100) &&
   (later.cancel === true
     ? later.at === undefined
-    : dateTime(later.at) && text(later.about, 4000) && later.cancel === undefined);
+    : dateTime(later.at) && text(later.about, 4000) && later.cancel !== true);
 
 const validUsage = (usage: unknown) =>
   usage === undefined ||
diff --git a/tests/later-cancel.test.ts b/tests/later-cancel.test.ts
new file mode 100644
index 0000000..58362e4
--- /dev/null
+++ b/tests/later-cancel.test.ts
@@ -0,0 +1,26 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { parseResult } from "../protocol/validate.ts";
+
+const at = "2026-11-24T06:30:00+08:00";
+
+// 2026-11-24：回执里写 "cancel": false 曾让整份回执被拒（later 全部丢失），
+// 但报错只说「要有 key/at/about」，看不出是 cancel 的问题。
+// false 与「不写」语义相同，不应被拒。
+test("cancel: false 等价于不取消", () => {
+  const r = parseResult({ outcome: "done", later: [{ key: "k", at, about: "再看", cancel: false }] });
+  assert.equal(r.later?.[0]?.key, "k");
+});
+
+test("cancel: true 仍按取消处理，且不许同时给 at", () => {
+  const r = parseResult({ outcome: "done", later: [{ key: "k", cancel: true }] });
+  assert.equal(r.later?.[0]?.cancel, true);
+  assert.throws(() => parseResult({ outcome: "done", later: [{ key: "k", at, about: "x", cancel: true }] }));
+});
+
+test("真正不合规的项仍被拒收（缺 at、缺 key、超过 10 项）", () => {
+  assert.throws(() => parseResult({ outcome: "done", later: [{ key: "k", about: "缺 at" }] }), "缺 at 应拒");
+  assert.throws(() => parseResult({ outcome: "done", later: [{ at, about: "缺 key" }] }), "缺 key 应拒");
+  const many = Array.from({ length: 11 }, (_, i) => ({ key: `k${i}`, at, about: "x" }));
+  assert.throws(() => parseResult({ outcome: "done", later: many }), "超过 10 项应拒");
+});
