#!/bin/zsh
# ============================================================
# watch_workbuddy_mem.sh — WorkBuddy 内存自愈守护 (Mac Mini M4 16G)
#
# 双通道触发(连续 SUSTAIN 次采样均满足才动作, 防误杀):
#   A) WorkBuddy 进程树自身总内存 > RSS_RESTART_MB   (默认 6000MB, 主通道: 治泄漏)
#   B) 整机可用内存 < SYS_CRIT_AVAILABLE_MB           (默认 512MB, 用户原始诉求: 治标)
#      或系统内存压力等级 >= 4(critical)
#      → B 通道同时要求 WB 树内存 > RSS_FLOOR_MB(默认 800MB, 避免重启"无辜"的空闲应用)
#
# 安全护栏:
#   - SUSTAIN 连续确认 / COOLDOWN_SEC 冷却 / 30 分钟内最多 MAX_RESTARTS_30MIN 次
#   - 精确 PID 定位, 优雅退出优先 (AppleScript quit → 轮询等待 → TERM → KILL 兜底),
#     重启后回读验证新主进程 + 对话完整性自检
#   - 绝不使用 pkill -f "WorkBuddy" 模糊匹配 (会误杀 sidecar 对话载体)
#   - --dry-run 只测量打印, 不执行任何 kill
#
# 2026-08-05 优化 (修复"重启后 UI 对话内容消失"):
#   - 原实现 TERM 主进程后固定 sleep 8 即 KILL 全部残留, renderer/daemon 来不及
#     flush 对话状态(IndexedDB/WAL/会话恢复信息), 重启后 UI 对话空白/未恢复。
#   - 现改为: AppleScript quit 走 app 正常关闭流程, 轮询等待全部进程自然退出
#     (QUIT_WAIT_SEC=30s), 超时才 TERM(TERM_WAIT_SEC=10s), 仍超时才 KILL。
#   - 重启成功后新增 verify_conversations 自检 (sessions.json 会话数), 异常即推飞书告警。
#   - 环境变量: QUIT_WAIT_SEC / TERM_WAIT_SEC 可调。
#
# 用法: watch_workbuddy_mem.sh [--dry-run] [--oneshot]
# 环境变量可在 launchd plist 中覆盖: WATCH_INTERVAL/SUSTAIN/RSS_RESTART_MB/
#     SYS_CRIT_AVAILABLE_MB/RSS_FLOOR_MB/COOLDOWN_SEC/MAX_RESTARTS_30MIN/LOG_FILE
# ============================================================

: "${WATCH_INTERVAL:=10}"
: "${SUSTAIN:=2}"
: "${RSS_RESTART_MB:=6000}"
: "${SYS_CRIT_AVAILABLE_MB:=512}"
: "${RSS_FLOOR_MB:=800}"
: "${COOLDOWN_SEC:=300}"
: "${MAX_RESTARTS_30MIN:=2}"
: "${QUIT_WAIT_SEC:=30}"    # 优雅退出后轮询等待全部进程退出的秒数(给 renderer flush 对话状态的时间)
: "${TERM_WAIT_SEC:=10}"    # TERM 兜底后等待秒数
: "${LOG_FILE:=$HOME/Library/Logs/workbuddy_memwatch.log}"

DRY_RUN=0; ONESHOT=0
for a in "$@"; do
  case "$a" in
    --dry-run) DRY_RUN=1 ;;
    --oneshot) ONESHOT=1 ;;
  esac
done

PAGE_SIZE=$(sysctl -n hw.pagesize)

log(){ echo "[$(date '+%F %T')] $*" >> "$LOG_FILE"; }

trim_log(){
  local size
  size=$(stat -f%z "$LOG_FILE" 2>/dev/null || echo 0)
  if (( size > 5242880 )); then
    tail -n 500 "$LOG_FILE" > "$LOG_FILE.tmp" 2>/dev/null && mv "$LOG_FILE.tmp" "$LOG_FILE"
  fi
}

# ---- 互斥锁 (mkdir 锁; 修复残留处理: 先删 pid 文件再删目录, 防 trap 未执行导致的卡死) ----
LOCK_DIR="/tmp/workbuddy_memwatch.lock"
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  # 锁目录已存在: 若属主进程仍存活则视为已有实例
  if [ -f "$LOCK_DIR/pid" ] && kill -0 "$(cat "$LOCK_DIR/pid" 2>/dev/null)" 2>/dev/null; then
    echo "[$(date '+%F %T')] 已有实例在运行, 退出" >> "$LOG_FILE"
    exit 0
  fi
  # 陈旧锁 (属主已死): 先删 pid 文件(rmdir 只删空目录), 再删目录, 重新获取
  rm -f "$LOCK_DIR/pid"
  rmdir "$LOCK_DIR" 2>/dev/null
  mkdir "$LOCK_DIR" 2>/dev/null || { echo "[$(date '+%F %T')] 无法获取锁" >> "$LOG_FILE"; exit 1; }
fi
echo $$ > "$LOCK_DIR/pid"
trap 'rm -f "$LOCK_DIR/pid"; rmdir "$LOCK_DIR" 2>/dev/null' EXIT

# ---- 采集函数 ----
# WorkBuddy 进程树: 命令行含 WorkBuddy.app 的进程, 输出 "pid rss_kb"
wb_procs(){
  ps -axo pid=,rss=,command= | awk '/WorkBuddy\.app/ && !/watch_workbuddy_mem/ {print $1, $2}'
}
# 进程树总内存 MB
wb_total_mb(){
  local t=0 r
  while read -r _p r; do
    r=${r:-0}
    t=$(( t + r ))
  done < <(wb_procs)
  echo $(( t / 1024 ))
}
# 整机可用内存 MB (free+inactive+speculative+purgeable, 苹果可回收口径)
sys_available_mb(){
  local vm f i s p
  vm=$(vm_stat)
  f=$(echo "$vm" | awk '/Pages free/       {print $3}' | tr -d '.')
  i=$(echo "$vm" | awk '/Pages inactive/   {print $3}' | tr -d '.')
  s=$(echo "$vm" | awk '/Pages speculative/{print $3}' | tr -d '.')
  p=$(echo "$vm" | awk '/Pages purgeable/  {print $3}' | tr -d '.')
  echo $(( (f + i + s + p) * PAGE_SIZE / 1048576 ))
}
# 系统内存压力等级: 1=normal 2=warn 4=critical
sys_pressure_level(){ sysctl -n kern.memorystatus_vm_pressure_level 2>/dev/null || echo 0; }
# WorkBuddy 主进程 PID
# 匹配: 程序路径 .../Contents/MacOS/Electron 后跟空格或行尾;
# 排除子进程特征(--serve/--prewarm/daemon-app-server-entry/sidecar-entry/--require)
# 修复 P1-2: 主进程若带 --xxx 启动参数也能命中, 不再要求 Electron$ 精确结尾
wb_main_pids(){
  ps -axo pid=,command= | awk '/WorkBuddy\.app\/Contents\/MacOS\/Electron([[:space:]]|$)/ && !/(--serve|--prewarm|daemon-app-server-entry|sidecar-entry|--require)/ {print $1}'
}

# ---- 通知 (P2-1: 重启前通知用户; 失败不阻塞主流程) ----
notify_restart(){
  local reason="$1" title raw_body esc_body card
  title="🔴 WorkBuddy 内存自愈重启"
  raw_body="原因: ${reason} | WB=${WB_MB}MB 整机=${SYS_MB}MB 压力=${LVL}"
  esc_body=$(printf '%s' "$raw_body" | sed 's/\\/\\\\/g; s/"/\\"/g')
  # 1) 系统通知中心
  osascript -e "display notification \"${esc_body}\" with title \"${title}\"" 2>/dev/null
  # 2) 飞书卡片推送 (异步后台发送, 不阻塞重启动作; 内部已绝对路径定位 lark-cli; 失败静默)
  card="$HOME/WorkBuddy/Claw/.workbuddy/scripts/push_card.py"
  if [ -x "$card" ]; then
    ("$card" --title "$title" --level alert \
      --section "⚡ 触发原因" "$reason" \
      --section "📊 实测指标" "WB树=${WB_MB}MB | 整机可用=${SYS_MB}MB | 压力等级=${LVL}" \
      --chat-id "oc_9ee5303497f5e0e71666b610d6bdc346" >/dev/null 2>&1 &)
  fi
}

# ---- 优雅退出 (2026-08-05 优化: 修复重启后 UI 对话内容消失) ----
# 原实现: TERM 主进程后固定 sleep 8 → KILL 全部残留。
# 问题: renderer/daemon 来不及 flush 对话状态(IndexedDB/WAL/会话恢复信息),
#       重启后 UI 呈现空白/未恢复历史对话(实测数据仍在, 但 UI 恢复不完整)。
# 新实现: AppleScript quit(走 app 正常关闭流程) → 轮询等待全部进程自然退出
#         → 超时才 TERM → 仍超时才 KILL。最大限度保留完整收尾时间。
graceful_quit(){
  local result waited n
  result=$(osascript -e 'tell application "WorkBuddy" to quit' 2>&1)
  if (( $? != 0 )); then
    log "    osascript quit 不可用($result), 降级 TERM"
    return 1
  fi
  waited=0
  while (( waited < QUIT_WAIT_SEC )); do
    n=$(wb_procs | wc -l | tr -d ' ')
    if (( n == 0 )); then
      log "    AppleScript quit 生效, 全部进程在 ${waited}s 内自然退出"
      return 0
    fi
    sleep 2
    waited=$((waited+2))
  done
  log "    AppleScript quit 等待 ${QUIT_WAIT_SEC}s 后仍有 ${n} 个进程, 降级 TERM"
  return 1
}
# 轮询等待 WorkBuddy 进程树清空, 返回 0=已清空 1=超时
wait_all_exit(){
  local limit="$1" waited n
  waited=0
  while (( waited < limit )); do
    n=$(wb_procs | wc -l | tr -d ' ')
    (( n == 0 )) && { log "    进程树已清空 (等待 ${waited}s)"; return 0; }
    sleep 2
    waited=$((waited+2))
  done
  return 1
}
# 残留清理: 先 TERM, 再 KILL(与旧逻辑一致, 但仅在优雅退出超时后才执行)
cleanup_residual(){
  local remaining
  remaining=($(wb_procs | awk '{print $1}'))
  if (( ${#remaining[@]} > 0 )); then
    log "    清理残留进程(TERM): ${remaining[*]}"
    kill "${remaining[@]}" 2>/dev/null
    wait_all_exit "$TERM_WAIT_SEC" && return 0
    remaining=($(wb_procs | awk '{print $1}'))
    if (( ${#remaining[@]} > 0 )); then
      log "    TERM 超时, KILL -9: ${remaining[*]}"
      kill -9 "${remaining[@]}" 2>/dev/null
      sleep 2
    fi
  fi
}
# 重启后对话完整性自检 (验证回读: 观察≠transition, 2026-08-05)
verify_conversations(){
  local sf n card
  sf="$HOME/.workbuddy/app/sessions.json"
  card="$HOME/WorkBuddy/Claw/.workbuddy/scripts/push_card.py"
  n=$(grep -c '"conversationId"' "$sf" 2>/dev/null || true)
  n=${n:-0}
  if (( n < 1 )); then
    log "!! 重启后会话元数据为空(${n}), 推送告警"
    if [ -x "$card" ]; then
      ("$card" --title "⚠️ 重启后对话恢复异常" --level warn \
        --section "检测结果" "sessions.json 会话数=${n}(期望≥1)" \
        --section "处置建议" "若 UI 对话空白, 请在侧边栏切换会话或重启应用" \
        --chat-id "oc_9ee5303497f5e0e71666b610d6bdc346" >/dev/null 2>&1 &)
    fi
  else
    log "    重启后会话元数据正常: ${n} 个会话"
  fi
}

# ---- 重启动作 ----
do_restart(){
  local reason="$1" now mainpids remaining newpids
  now=$(date +%s)

  # 冷却 (仅统计真实执行的重启; 修复: LAST_RESTART 此前从未赋值, 冷却形同虚设)
  if (( now - LAST_RESTART < COOLDOWN_SEC )); then
    log "== 冷却期内(距上次重启 $((now-LAST_RESTART))s < ${COOLDOWN_SEC}s), 跳过"
    return
  fi
  # 30 分钟窗口内真实重启次数上限 (失败/干跑不再计入, 修复 P1-1)
  local cutoff=$(( now - 1800 )) n=0
  for ts in "${RESTART_HISTORY[@]}"; do
    (( ts > cutoff )) && ((n++))
  done
  if (( n >= MAX_RESTARTS_30MIN )); then
    log "== 30 分钟内已重启 ${n} 次, 进入 30min 冷静期"
    sleep 1800
    return
  fi

  log "==> 触发重启($reason): WB树=${WB_MB}MB 整机可用=${SYS_MB}MB 压力等级=${LVL} dry_run=${DRY_RUN}"
  if (( DRY_RUN )); then
    log "    [dry-run] 以上为将执行的重启动作, 未做任何操作"
    return
  fi

  # 通知 (P2-1) + 3s 反应时间
  notify_restart "$reason"
  sleep 3

  # 1) 优雅退出链 (2026-08-05): AppleScript quit → 轮询 → TERM → 轮询 → KILL 兜底
  #    Electron 正常关闭流程会让 renderer 完整 flush 对话状态, 重启后 UI 才能恢复历史对话
  mainpids=($(wb_main_pids))
  if (( ${#mainpids[@]} == 0 )); then
    log "!! 未匹配到主进程, 跳过优雅退出, 直接残留清理"
  else
    log "    优雅退出主进程: ${mainpids[*]} (AppleScript quit, 等待≤${QUIT_WAIT_SEC}s)"
    if ! graceful_quit; then
      log "    降级: kill -TERM ${mainpids[*]}"
      kill -TERM "${mainpids[@]}" 2>/dev/null
      wait_all_exit "$TERM_WAIT_SEC" || cleanup_residual
    fi
  fi

  # 2) 兜底清理残留 (仅当优雅退出链路未清干净时执行)
  cleanup_residual
  sleep 2

  # 3) 验证已退出 (验证回读: 观察≠完成)
  remaining=($(wb_procs | awk '{print $1}'))
  if (( ${#remaining[@]} > 0 )); then
    log "!! 仍有残留进程 ${remaining[*]} 无法退出, 放弃重启"
    RESTART_HISTORY+=("$now")   # 失败熔断: 残留清不掉→无限重试+通知轰炸的回归(08-04终审发现)
    LAST_RESTART=$now
    return 1
  fi

  # 4) 重启(路径优先, P2-2) + 回读验证新主进程; 成功后才计入历史(修复 P1-1)
  open "$HOME/Desktop/WorkBuddy.app" 2>/dev/null || open -a WorkBuddy 2>/dev/null
  sleep 12
  newpids=($(wb_main_pids))
  if (( ${#newpids[@]} == 0 )); then
    log "!! 重启未检测到新主进程, 再试一次"
    open "$HOME/Desktop/WorkBuddy.app" 2>/dev/null
    sleep 12
    newpids=($(wb_main_pids))
  fi
  if (( ${#newpids[@]} > 0 )); then
    log "==> 重启成功, 新主进程 PID: ${newpids[*]}"
    RESTART_HISTORY+=("$now")
    LAST_RESTART=$now
    sleep 15   # 等会话列表加载
    verify_conversations
    sleep 45   # 启动保护期
  else
    log "!! 重启失败: open 后仍未检测到新主进程 (不计数, 可重试)"
  fi
}

# ---- 主循环 ----
LAST_RESTART=0
RESTART_HISTORY=()
streak=0
log "监控启动: interval=${WATCH_INTERVAL}s sustain=${SUSTAIN} rss_thr=${RSS_RESTART_MB}MB sys_crit=${SYS_CRIT_AVAILABLE_MB}MB floor=${RSS_FLOOR_MB}MB cooldown=${COOLDOWN_SEC}s max30m=${MAX_RESTARTS_30MIN} dry_run=${DRY_RUN} $(zsh --version | head -1)"

while true; do
  WB_MB=$(wb_total_mb)
  SYS_MB=$(sys_available_mb)
  LVL=$(sys_pressure_level)

  trigger=0; reason=""
  if (( WB_MB > RSS_RESTART_MB )); then
    trigger=1; reason="WB树 ${WB_MB}MB > ${RSS_RESTART_MB}MB"
  elif (( SYS_MB < SYS_CRIT_AVAILABLE_MB && WB_MB > RSS_FLOOR_MB )); then
    trigger=1; reason="整机可用 ${SYS_MB}MB < ${SYS_CRIT_AVAILABLE_MB}MB 且 WB=${WB_MB}MB"
  elif (( LVL >= 4 && WB_MB > RSS_FLOOR_MB )); then
    trigger=1; reason="压力等级 ${LVL}(critical) 且 WB=${WB_MB}MB"
  fi

  if (( trigger )); then
    ((streak++))
    log "候选 ${streak}/${SUSTAIN}: ${reason}"
    if (( streak >= SUSTAIN )); then
      streak=0
      do_restart "$reason"
    fi
  else
    (( streak > 0 )) && log "候选解除"
    streak=0
  fi

  (( ONESHOT )) && break
  sleep "$WATCH_INTERVAL"
  trim_log
done
exit 0
