#!/usr/bin/python3
"""
agent-autoloop 执行体 —— DeepSeek（经本机 9999 代理）

为什么不用 codex CLI：codex-cli 0.166.0 已移除 wire_api="chat"，只认 Responses API，
而 DeepSeek/本机代理只有 Chat Completions。这里直接用标准库做最小 function-calling 循环。

约定：
  stdout = 最终结论文本（中台 command 插件只读 stdout）
  stderr = 全过程日志（中台写入 runs/*/stderr-1.log，供 agent-autoloop why 排查）
凭据：本机代理自己持有上游 DEEPSEEK_API_KEY，客户端 Authorization 被忽略，无需任何 key。
"""

# shebang=/usr/bin/python3 是系统 3.9：`str | None` 注解在 def 时求值会 TypeError，
# 必须有这行把注解延迟为字符串（2026-11-13 run #78 事故换来的）。
from __future__ import annotations

import json
import os
import subprocess
import sys
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

PROXY = os.environ.get(
    "AUTOLOOP_DS_URL", "http://127.0.0.1:9999/v1/chat/completions"
)
MODEL = os.environ.get("AUTOLOOP_MODEL", "deepseek-v4-flash")
MAX_ROUNDS = int(os.environ.get("AUTOLOOP_MAX_ROUNDS", "30"))
MAX_TOOL_CHARS = int(os.environ.get("AUTOLOOP_MAX_TOOL_CHARS", "12000"))
# 2026-11-13 22:3x：原硬编码 max_tokens=2000，长报告（约 5KB 中文）塞不进 →
# tool_calls.arguments 被截断成不完整 JSON → json.loads 抛错被静默吞成 {} →
# run_tool 里 args["path"] 抛 KeyError。故障在 11-12/11-13 反复出现 ≥5 次，
# 中台被迫每次改用 heredoc 分段落盘。工具输出上限本就是 12000 字符，
# 这里给 8000 token 留 2-3 倍余量；env 可退回 2000 做 A/B 与回滚。
MAX_OUTPUT_TOKENS = int(os.environ.get("AUTOLOOP_MAX_TOKENS", "8000"))
HTTP_TIMEOUT = int(os.environ.get("AUTOLOOP_TIMEOUT", "120"))
SHELL_TIMEOUT = int(os.environ.get("AUTOLOOP_SHELL_TIMEOUT", "60"))

SYSTEM = """你是 agent-autoloop 的执行 Agent，在给定的工作目录里完成任务。
可用工具：read_file（读文本文件）、write_file（写文本文件，仅限当前工作目录内）、run_shell（执行命令）。
权限（2026-11-11 16:22 用户授权「除实盘交易外全部最高权限推进项目进度」）：
- 可以改任意项目代码、配置、文档、测试；可以 git add / commit / push；可以新建或删除本轮生成的文件；
  可以自主做产品判断；high 风险任务也可推进，但必须写清验收与回滚。
- 质量护栏不因授权解除：结论必须有证据、验收命令必须真跑、DONE 必须带原始输出（外部闸门会独立核验）。
底线（代码级硬拦截，非提示词）：
- 不下单、不碰实盘账本 .workbuddy/data/user/portfolio.json（用户操作实盘由本人执行）；
- 不改 git 历史 / 分支保护 / 强制推送；
- 不读取或外泄凭据、密钥、环境变量。
- 完成后只输出一段简短的最终结论（中文），不要输出过程、不要输出工具内容。
- 工具调用预算共 {max_rounds} 轮。请尽早写出任务要求的交付文件，再用剩余轮次补充证据；
  不要无限探索，最后几轮务必给出最终结论。
""".format(max_rounds=MAX_ROUNDS)

TOOLS = [
    {
        "type": "function",
        "function": {
            "name": "read_file",
            "description": "读取一个文本文件的完整内容（只读）",
            "parameters": {
                "type": "object",
                "properties": {"path": {"type": "string", "description": "文件路径，绝对或相对当前目录"}},
                "required": ["path"],
            },
        },
    },
    {
        "type": "function",
        "function": {
            "name": "write_file",
            "description": "写入文本文件，自动创建父目录；路径必须在当前工作目录内",
            "parameters": {
                "type": "object",
                "properties": {
                    "path": {"type": "string", "description": "相对当前目录的路径"},
                    "content": {"type": "string", "description": "文件完整内容"},
                },
                "required": ["path", "content"],
            },
        },
    },
    {
        "type": "function",
        "function": {
            "name": "run_shell",
            "description": "在当前工作目录执行一条 shell 命令，返回 stdout/stderr 与退出码",
            "parameters": {
                "type": "object",
                "properties": {"command": {"type": "string", "description": "要执行的命令"}},
                "required": ["command"],
            },
        },
    },
]


def log(*parts):
    print(*(str(p) for p in parts), file=sys.stderr, flush=True)


def clip(text):
    text = str(text)
    if len(text) > MAX_TOOL_CHARS:
        return text[:MAX_TOOL_CHARS] + "\n...[截断，共 %d 字符]" % len(text)
    return text


def call_llm(messages, allow_tools=True):
    body = {
        "model": MODEL,
        "messages": messages,
        "tools": TOOLS,
        "tool_choice": "auto" if allow_tools else "none",
        "stream": False,
        "max_tokens": MAX_OUTPUT_TOKENS,
    }
    req = urllib.request.Request(
        PROXY,
        data=json.dumps(body, ensure_ascii=False).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            # 代理忽略客户端凭据；占位仅满足网关格式
            "Authorization": "Bearer local-proxy-noop",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as resp:
            if resp.status != 200:
                raise RuntimeError("非 200 响应: %s" % resp.status)
            raw = resp.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        detail = e.read().decode("utf-8", "replace")[:500]
        raise RuntimeError("HTTP %s: %s" % (e.code, detail)) from e
    data = json.loads(raw)
    accumulate_usage(USAGE_TOTAL, data.get("usage"))
    choices = data.get("choices") or []
    if not choices:
        raise RuntimeError("响应无 choices: %s" % raw[:300])
    choice = choices[0]
    # 2026-11-14（审计 D6）：刻意**不**启用 thinking=disabled —— 当前 15 轮无「content 为空」
    # 证据，改行为（可能让推理变浅）风险高于收益。改为观测：截断或空回执时留痕，
    # 让「reasoning 吃光输出」从不可见变为可诊断；真出现再按群日报同款双写 disabled。
    if choice.get("finish_reason") == "length":
        log("  !! 输出达到 max_tokens=%d 上限被截断（finish_reason=length）" % MAX_OUTPUT_TOKENS)
    msg = choice["message"]
    if not (msg.get("content") or "").strip() and not (msg.get("tool_calls") or []):
        log("  !! 空回执且无工具调用：疑似 reasoning 占满输出（可考虑 thinking=disabled）")
    return msg


LIVE_BOOK = ".workbuddy/data/user/portfolio.json"  # 实盘账本：中台硬隔离，由用户本人操作


def forbidden_live_book(text: str) -> bool:
    """代码级硬拦截：任何触碰实盘账本的写入或 shell 命令一律拒绝。"""
    return LIVE_BOOK in text or "data/user/portfolio" in text


def parse_tool_args(raw: str):
    """返回 (args, error)。截断/非法 JSON 不再静默吞成 {}，让调用方把明确错误回给模型。

    2026-11-13：原循环 `except JSONDecodeError: args = {}` 是 KeyError 的根源——
    失败不可诊断、模型也拿不到可重试的提示。抽成函数后失败路径可被自测反证。
    """
    try:
        obj = json.loads(raw or "{}")
    except json.JSONDecodeError as exc:
        return None, (
            "工具参数 JSON 不完整（%d 字符，可能被 max_tokens=%d 截断；%s）"
            % (len(raw or ""), MAX_OUTPUT_TOKENS, exc)
        )
    if not isinstance(obj, dict):
        return None, "工具参数不是对象（%s）" % type(obj).__name__
    return obj, None


REQUIRED_ARGS = {
    "read_file": ("path",),
    "write_file": ("path", "content"),
    "run_shell": ("command",),
}


def run_tool(name, args):
    need = REQUIRED_ARGS.get(name)
    if need:
        missing = [k for k in need if k not in args]
        if missing:
            return "ERROR: 工具 %s 缺参数 %s（收到键：%s）" % (
                name, ",".join(missing), ",".join(sorted(args)) or "空"
            )
    try:
        if name == "read_file":
            p = Path(args["path"])
            if not p.is_absolute():
                p = Path.cwd() / p
            return clip(p.read_text(encoding="utf-8", errors="replace"))
        if name == "write_file":
            root = Path.cwd().resolve()
            p = (root / args["path"]).resolve()
            if root not in p.parents and p != root:
                return "ERROR: 路径越出当前工作目录，已拒绝"
            if forbidden_live_book(str(p)):
                return "ERROR: 实盘账本禁止中台写入（用户本人操作），已拒绝"
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(args["content"], encoding="utf-8")
            return "OK: 已写入 %s (%d 字符)" % (p, len(args["content"]))
        if name == "run_shell":
            if forbidden_live_book(args["command"]):
                return "ERROR: 实盘账本禁止中台访问（用户本人操作），已拒绝"
            proc = subprocess.run(
                args["command"],
                shell=True,
                cwd=Path.cwd(),
                capture_output=True,
                text=True,
                timeout=SHELL_TIMEOUT,
            )
            return clip(
                "rc=%d\n--- stdout ---\n%s\n--- stderr ---\n%s"
                % (proc.returncode, proc.stdout, proc.stderr)
            )
        return "ERROR: 未知工具 %s" % name
    except subprocess.TimeoutExpired:
        return "ERROR: 命令超时 (%ds)" % SHELL_TIMEOUT
    except Exception as exc:
        return "ERROR: %s: %s" % (type(exc).__name__, exc)


QUEUE_RULE = "项目自动驾驶"
QUEUE_PATH = Path(".autopilot/QUEUE.md")
USAGE_TOTAL = {}


def dispatch_ck(prompt: str) -> str | None:
    """B 方案（2026-11-12 用户授权）：机器侧提取本轮派活关联键。

    只认「按规则「项目自动驾驶」」的派活，只取 QUEUE TODO 首条；首条没有合法
    ck 就不注入、不取第二条来猜。解析复用 Claw 仓 canonical_key 单一真源，
    执行体不自造格式；导入/读取失败一律 fail-safe 跳过，绝不因注入失败而中断任务。
    """
    if ("按规则「%s」" % QUEUE_RULE) not in (prompt or ""):
        return None
    try:
        sys.path.insert(0, str(Path("scripts").resolve()))
        import canonical_key as ck  # noqa: PLC0415
    except Exception as exc:
        log("canonical_key 导入失败，跳过注入（fail-safe）: %s" % exc)
        return None
    try:
        text = QUEUE_PATH.read_text(encoding="utf-8")
    except OSError as exc:
        log("QUEUE 读取失败，跳过注入: %s" % exc)
        return None
    key, reason = ck.from_queue_todo(text)
    if key is None:
        log("TODO 首条无合法 ck（%s），不注入" % reason)
        return None
    return key


def write_runner_meta(key: str) -> None:
    """把派活记录写进内核的每轮目录（与 context.json 同目录，归属结构化成立）。

    原子写（tmp + replace），不碰内核自己的 context.json；失败向上抛由 main 记日志继续。
    """
    ctx_path = os.environ.get("AGENT_AUTOLOOP_CONTEXT")
    if not ctx_path:
        log("无 AGENT_AUTOLOOP_CONTEXT，不写 runner-meta")
        return
    meta = Path(ctx_path).parent / "runner-meta.json"
    payload = {
        "expected_ck": key,
        "source": "queue_todo_first",
        "run": os.environ.get("AGENT_AUTOLOOP_RUN"),
        "injected_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
    }
    tmp = meta.with_name(meta.name + ".tmp")
    tmp.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
    tmp.replace(meta)
    log("runner-meta 写入 %s: %s" % (meta, key))


def accumulate_usage(total, resp_usage):
    """DeepSeek usage -> 内核 Usage 累计。input 含缓存（内核 #271 口径），cached 单列。"""
    resp_usage = resp_usage or {}
    if not resp_usage:
        return total
    total["input"] = total.get("input", 0) + (resp_usage.get("prompt_tokens") or 0)
    total["output"] = total.get("output", 0) + (resp_usage.get("completion_tokens") or 0)
    details = resp_usage.get("prompt_tokens_details") or {}
    total["cached"] = total.get("cached", 0) + (details.get("cached_tokens") or 0)
    return total


def usage_marker_text(total):
    """给本机插件解析的 stderr 标记行；无用量返回 None（不打标记）。"""
    if not total:
        return None
    return "AGENT_USAGE_JSON " + json.dumps({k: total[k] for k in sorted(total)}, ensure_ascii=False)


def emit_usage_marker():
    text = usage_marker_text(USAGE_TOTAL)
    if text:
        log(text)


def self_test() -> int:
    cases: list[tuple[str, bool]] = []
    # 2026-11-13 22:3x：长内容 KeyError 根因修复的正反样本（旧版逐条会被击破）
    cases.append(("输出上限高于旧的 2000 token（长报告不再被硬截断）",
                  MAX_OUTPUT_TOKENS > 2000))
    ok_args, ok_err = parse_tool_args('{"path": "docs/x.md", "content": "hello"}')
    cases.append(("完整工具参数可解析且无错误",
                  ok_err is None and ok_args is not None and ok_args.get("path") == "docs/x.md"))
    bad_args, bad_err = parse_tool_args('{"path": "docs/x.md", "content": "很长的正文被截断')
    cases.append(("截断 JSON 不再静默吞成空 dict，而是返回可回给模型的错误",
                  bad_args is None and bad_err is not None and "max_tokens" in bad_err))
    cases.append(("JSON 合法但缺 content 时返回明确 ERROR 而非 KeyError",
                  run_tool("write_file", {"path": "docs/x.md"}).startswith(
                      "ERROR: 工具 write_file 缺参数")))
    cases.append(("非对象参数被拒", parse_tool_args("[1,2]")[1] is not None))
    # 2026-11-14（审计 D7）：REQUIRED_ARGS 是隐性契约 —— 新增工具忘登记则缺键检查静默失效。
    cases.append((
        "REQUIRED_ARGS 覆盖全部工具（新增工具必须登记）",
        {t["function"]["name"] for t in TOOLS} == set(REQUIRED_ARGS),
    ))
    # 用量上报（内核 #271 口径：input 含缓存，cached 单列；标 2026-11-13 补齐）
    t = accumulate_usage({}, {"prompt_tokens": 100, "completion_tokens": 20,
                              "prompt_tokens_details": {"cached_tokens": 60}})
    t = accumulate_usage(t, {"prompt_tokens": 50, "completion_tokens": 10})
    cases.append(("用量累计 input 含缓存且 cached 单列",
                  t == {"input": 150, "output": 30, "cached": 60}))
    cases.append(("空 usage 不产生字段", accumulate_usage({}, None) == {}))
    marker = usage_marker_text({"input": 150, "output": 30, "cached": 60})
    cases.append(("用量标记行格式可被本机插件解析",
                  marker == 'AGENT_USAGE_JSON {"cached": 60, "input": 150, "output": 30}'))
    cases.append(("无用量时不打标记", usage_marker_text({}) is None))
    cases.append(("非目标规则不注入", dispatch_ck("Agent 自动化中台按规则「群消息 AI 研判 · 立即推进」派活。") is None))
    cases.append(("目标规则字符串命中",
                  "按规则「项目自动驾驶」" in "Agent 自动化中台按规则「项目自动驾驶」把这件活派给你。"))
    key = dispatch_ck("Agent 自动化中台按规则「项目自动驾驶」把这件活派给你。")
    cases.append(("真实 QUEUE 注入结果要么为 None（首条无 ck）要么为合法键",
                  key is None or bool(key and key.count(":") == 2)))
    if key:
        import canonical_key as ck  # noqa: PLC0415
        cases.append(("注入键通过单一真源严格校验", ck.is_valid(key)))
    import tempfile  # noqa: PLC0415
    with tempfile.TemporaryDirectory() as td:
        ctx_dir = Path(td) / "77-1"
        ctx_dir.mkdir()
        saved = os.environ.get("AGENT_AUTOLOOP_CONTEXT")
        os.environ["AGENT_AUTOLOOP_CONTEXT"] = str(ctx_dir / "context.json")
        try:
            write_runner_meta("manual:chore:T-013")
            meta = ctx_dir / "runner-meta.json"
            data = json.loads(meta.read_text(encoding="utf-8"))
            cases.append(("runner-meta 原子写入且可回读",
                          data["expected_ck"] == "manual:chore:T-013" and data["source"] == "queue_todo_first"))
            cases.append(("写入不产生 tmp 残留", not (ctx_dir / "runner-meta.json.tmp").exists()))
        finally:
            if saved is None:
                os.environ.pop("AGENT_AUTOLOOP_CONTEXT", None)
            else:
                os.environ["AGENT_AUTOLOOP_CONTEXT"] = saved
    for label, ok in cases:
        log("%s %s" % ("[PASS]" if ok else "[FAIL]", label))
    good = all(ok for _, ok in cases)
    log("执行体注入自检: %s（%d/%d）" % ("OK" if good else "失败", sum(ok for _, ok in cases), len(cases)))
    return 0 if good else 1


def main():
    if "--self-test" in sys.argv:
        return self_test()
    if len(sys.argv) < 2 or not sys.argv[1].strip():
        log("缺少 prompt")
        return 2
    prompt = sys.argv[1]
    try:
        key = dispatch_ck(prompt)
    except Exception as exc:
        log("注入阶段意外失败（fail-safe 继续执行）: %s" % exc)
        key = None
    system = SYSTEM
    if key:
        try:
            write_runner_meta(key)
        except Exception as exc:
            log("runner-meta 写入失败（不影响本轮执行）: %s" % exc)
        system = SYSTEM + (
            "\n本轮派活关联键（runner 机器注入，来源 QUEUE TODO 首条）：" + key +
            "。最终结论摘要必须原样包含这段 ck= 文本，外部闸门按它核验本轮任务；"
            "若实际做的任务与该编号不符，照实写实际编号，不要硬套。"
        )
    messages = [
        {"role": "system", "content": system},
        {"role": "user", "content": prompt},
    ]
    log("backend=deepseek proxy=%s model=%s cwd=%s" % (PROXY, MODEL, Path.cwd()))
    for turn in range(1, MAX_ROUNDS + 1):
        try:
            msg = call_llm(messages)
        except Exception as exc:
            log("第 %d 轮 LLM 调用失败: %s" % (turn, exc))
            return 1
        messages.append(msg)
        calls = msg.get("tool_calls") or []
        if not calls:
            final = (msg.get("content") or "").strip()
            if not final:
                # flash 模型偶发「既无工具调用也无文本」的空回执，补问一次要结论
                log("第 %d 轮空回执，补问一次结论" % turn)
                try:
                    retry = call_llm(
                        messages
                        + [
                            {
                                "role": "user",
                                "content": "请直接输出最终结论文本（中文，简短），不要调用工具，也不要留空。",
                            }
                        ],
                        allow_tools=False,
                    )
                    final = (retry.get("content") or "").strip()
                except Exception as exc:
                    log("补问失败: %s" % exc)
            log("第 %d 轮结束，最终文本 %d 字符" % (turn, len(final)))
            if not final:
                log("补问后仍为空回执")
                return 1
            print(final)
            return 0
        log("第 %d 轮：%d 个工具调用" % (turn, len(calls)))
        for tc in calls:
            fn = tc.get("function") or {}
            name = fn.get("name", "")
            args, arg_err = parse_tool_args(fn.get("arguments") or "")
            if arg_err:
                log("  !! %s %s" % (name, arg_err))
                log("     arguments 尾部: %s" % (fn.get("arguments") or "")[-160:].replace("\n", " "))
                messages.append(
                    {
                        "role": "tool",
                        "tool_call_id": tc.get("id", ""),
                        "content": (
                            "ERROR: " + arg_err
                            + "。请把长内容拆成多次 write_file 分段写入，或缩短后重试；不要直接放弃任务。"
                        ),
                    }
                )
                continue
            log("  -> %s %s" % (name, json.dumps(args, ensure_ascii=False)[:200]))
            result = run_tool(name, args)
            log("  <- %s" % clip(result)[:300].replace("\n", " | "))
            messages.append(
                {"role": "tool", "tool_call_id": tc.get("id", ""), "content": result}
            )
    log("达到轮次上限 %d，强制收尾（不再允许工具调用）" % MAX_ROUNDS)
    try:
        final_msg = call_llm(
            messages
            + [
                {
                    "role": "user",
                    "content": "轮次已用尽。请立刻基于已经掌握的信息给出最终结论，只输出结论文本，不要再做任何探索。",
                }
            ],
            allow_tools=False,
        )
    except Exception as exc:
        log("收尾调用失败: %s" % exc)
        return 1
    final = (final_msg.get("content") or "").strip()
    log("强制收尾，最终文本 %d 字符" % len(final))
    if not final:
        log("收尾仍为空回执")
        return 1
    print(final)
    return 0


if __name__ == "__main__":
    _rc = 2
    try:
        _rc = main()
    finally:
        # 无论成败都上报已消耗用量（stderr 标记行，本机 command 插件解析；不打进 stdout/摘要）
        emit_usage_marker()
    sys.exit(_rc)
